# Godot 4 — engine cache and imported artifacts
.godot/
/build/
*.translation

# Godot .NET / mono build output (editor is a mono build; we ship GDScript)
.mono/
data_*/
mono_crash.*.json
bin/
obj/
*.csproj.user

# export_presets.cfg IS committed: CI needs it to build the web release.
# It must therefore stay free of machine-specific paths — CI installs export
# templates to the standard location and relies on the default lookup.

# Exported builds are produced by CI, never committed.
/build/
/web-build/

# Test/CI scratch
/tests/_out/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Machine-local Godot path used by tools/ci.sh
tools/godot_bin.local
