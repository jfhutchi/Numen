; Engine configuration file.
; NUMEN — see README.md, PROGRESS.md, DECISIONS.md

config_version=5

[application]

config/name="NUMEN"
config/description="An original god-game built around a creature that genuinely learns."
run/main_scene="res://src/core/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

Rng="*res://src/core/rng.gd"
World="*res://src/world/object_registry.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
; Godot 4 can only target WebGL 2.0 on the web; Forward+ and Mobile are not
; available there, so the browser build falls back to Compatibility. Everything
; NUMEN draws is StandardMaterial3D, sky and fog, all of which Compatibility
; supports — the visual difference is minor.
renderer/rendering_method.web="gl_compatibility"

[physics]

3d/physics_engine="Jolt Physics"
